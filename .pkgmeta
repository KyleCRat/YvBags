package-as: YvBags

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

externals:
  Libs/LibSimpleDB-2.0:
    url: https://github.com/KyleCRat/LibSimpleDB.git
    commit: e2f88dddfa8611a64cc3103d411c60559ccedfa6
  Libs/LibSimpleDBProfiles-1.0:
    url: https://github.com/KyleCRat/LibSimpleDBProfiles.git
    commit: ca50a20543ad8d54b9aaff3e4356f96cc02639bd

ignore:
  - .pkgmeta
  - .editorconfig
  - .gitattributes
  - .git
  - AGENTS.md
  - PLAN.md
  - TODO.md
  - "Libs/LibSimpleDB-2.0/benchmarks"
  - "Libs/LibSimpleDB-2.0/tests"
  - "Libs/LibSimpleDBProfiles-1.0/tests"
  - "*.afphoto"
  - "Media/Textures/*.afphoto"
  - "*.png"
  - "Media/Textures/*.png"
  - Media/Textures/Soulbound.tga
  - Media/Textures/UIGroupManager2x.BLP
  - Media/Textures/Vertex-Border.tga
